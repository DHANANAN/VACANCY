; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but since you are vibe-coding with your AI assistant, this is pre-configured for you!

config_version=5

[application]

config/name="VACANCY"
config/description="A first-person psychological horror game about isolation and reaching back."
run/main_scene="res://scenes/levels/house_full.tscn"
config/features=PackedStringArray("4.3", "4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/core/game_manager.gd"
AudioConductor="*res://scripts/core/audio_conductor.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

